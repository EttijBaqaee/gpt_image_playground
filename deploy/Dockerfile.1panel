# 1Panel build context contains the existing locked Linux dependencies.
FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS build
WORKDIR /app
ENV VITE_DEFAULT_API_URL=__VITE_DEFAULT_API_URL_PLACEHOLDER__
COPY . .
RUN npm run build:web && npm run build:server
RUN npm --prefix server prune --omit=dev --ignore-scripts --no-audit --no-fund

FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS production
WORKDIR /app
ENV NODE_ENV=production PORT=8787 HOST=0.0.0.0 DATA_DIR=/app/data WEB_DIST_DIR=/app/dist
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/server/package.json /app/server/package.json
COPY --from=build /app/server/node_modules /app/server/node_modules
COPY --from=build /app/server/dist /app/server/dist
COPY --from=build /app/dist /app/dist
COPY --from=build /app/LICENSE /app/LICENSE
RUN mkdir -p /app/data && chown node:node /app/data
LABEL org.opencontainers.image.source="https://github.com/EttijBaqaee/gpt_image_playground" org.opencontainers.image.revision="0477e08e8328652cfdfaf66c463970e626a9ff69+0.3.66.3" org.opencontainers.image.version="0.3.66.3" org.opencontainers.image.licenses="MIT"
USER node
VOLUME ["/app/data"]
EXPOSE 8787
CMD ["node", "/app/server/dist/index.js"]
