# Required: replace these values; keep existing values when upgrading.
APP_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_PASSWORD=replace-with-your-admin-password

APP_PORT=8788
# Independent prefixes. Empty selects the original path for that endpoint.
# Example: web, a, m, h -> /web/, /a/api/, /m/media/, /h/health.
APP_BASE_PATH=
API_BASE_PATH=
MEDIA_BASE_PATH=
HEALTH_BASE_PATH=
CORS_ORIGIN=*

# For CLI deployment leave these empty to use paths relative to deploy/docker-compose.yml.
# For 1Panel use absolute paths, e.g. /opt/gpt-image-playground and /opt/gpt-image-playground/docker-data.
APP_SOURCE_DIR=
APP_DATA_DIR=

# Empty does not trust forwarded client IPs. Only set actual proxy IPs or limited CIDRs.
TRUSTED_PROXIES=
UPLOAD_MAX_FILE_MB=32
UPLOAD_MAX_TOTAL_MB=128

# Optional initial provider; leave both blank and configure through the web UI.
UPSTREAM_API_URL=
UPSTREAM_API_KEY=
UPSTREAM_MODEL=gpt-image-2
UPSTREAM_API_MODE=images
UPSTREAM_TIMEOUT_SECONDS=300
UPSTREAM_CODEX_CLI=false
